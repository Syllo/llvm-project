; RUN: llc --mtriple=hexagon -mattr=+hvxv79,+hvx-length128b < %s | FileCheck %s

; Canonical round-trip generated by i32->v32i1 lowering should use the
; guarded fast-path for v32i1->i32 and fold away.
define i32 @canonical_roundtrip_i32(i32 %x) {
; CHECK-LABEL: canonical_roundtrip_i32:
; CHECK: // %bb.0:
; CHECK-NOT: setbit(
; CHECK-NOT: vextract(
; CHECK-NOT: vdeal
; CHECK-NOT: vshuff
; CHECK: jumpr r31
  %q = bitcast i32 %x to <32 x i1>
  %y = bitcast <32 x i1> %q to i32
  ret i32 %y
}

; Non-canonical v32i1->i32 inputs use the in-register reduction path.
define i32 @fallback_v32i1_to_i32(<32 x i1> %m) {
; CHECK-LABEL: fallback_v32i1_to_i32:
; CHECK-NOT: setbit(
; CHECK-NOT: memw(
; CHECK: vor(
; CHECK: vextract(
; CHECK: jumpr r31
  %y = bitcast <32 x i1> %m to i32
  ret i32 %y
}

; A predicate load is lowered through i32 -> v32i1, while the predicate store
; is lowered through v32i1 -> i32. Verify that the canonical matcher recognizes
; the reconstructed predicate and eliminates the per-lane packing fallback.
define void @canonical_roundtrip_v32i1_load_store(ptr %dst, ptr %src) {
; CHECK-LABEL: canonical_roundtrip_v32i1_load_store:
; CHECK-NOT: setbit(
; CHECK-NOT: vextract(
; CHECK-NOT: vdeal
; CHECK-NOT: vshuff
; CHECK-DAG: [[WORD:r[0-9]+]] = memw(r{{[0-9]+}}+#0)
; CHECK-DAG: memw(r{{[0-9]+}}+#0) = [[WORD]]{{(.new)?}}
%q = load volatile <32 x i1>, ptr %src, align 4
store volatile <32 x i1> %q, ptr %dst, align 4
ret void
}

; The v64i1 path applies the same matcher to both v32i1 halves.
define void @canonical_roundtrip_v64i1_load_store(ptr %dst, ptr %src) {
; CHECK-LABEL: canonical_roundtrip_v64i1_load_store:
; CHECK-NOT: setbit(
; CHECK-NOT: vextract(
; CHECK-NOT: vdeal
; CHECK-NOT: vshuff
; CHECK-DAG: [[DWORD:r[0-9]+:[0-9]+]] = memd(r{{[0-9]+}}+#0)
; CHECK-DAG: memd(r{{[0-9]+}}+#0) = [[DWORD]]
%q = load volatile <64 x i1>, ptr %src, align 8
store volatile <64 x i1> %q, ptr %dst, align 8
ret void
}
