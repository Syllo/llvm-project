;; How far the block shape lookup gets from a ripple.block.index or
;; ripple.block.getsize operand back to the defining ripple.block.setshape.

;; The handle is found through pointer casts.
define i64 @through_pointer_cast() {
; CHECK-LABEL: define i64 @through_pointer_cast() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[BS:%.*]] = call ptr @llvm.ripple.block.setshape.i64(i64 0, i64 7, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1)
; CHECK-NEXT:    [[CAST:%.*]] = addrspacecast ptr [[BS]] to ptr addrspace(1)
; CHECK-NEXT:    [[CAST_BACK:%.*]] = addrspacecast ptr addrspace(1) [[CAST]] to ptr
; CHECK-NEXT:    [[ID:%.*]] = call range(i64 0, 7) i64 @llvm.ripple.block.index.i64(ptr [[CAST_BACK]], i64 0), !range [[RNG0:![0-9]+]]
; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[ID]], 7
; CHECK-NEXT:    ret i64 [[SUM]]
;
entry:
  %bs = call ptr @llvm.ripple.block.setshape.i64(i64 0, i64 7, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1)
  %cast = addrspacecast ptr %bs to ptr addrspace(1)
  %cast.back = addrspacecast ptr addrspace(1) %cast to ptr
  %id = call i64 @llvm.ripple.block.index.i64(ptr %cast.back, i64 0)
  %size = call i64 @llvm.ripple.block.getsize.i64(ptr %cast.back, i64 0)
  %sum = add i64 %id, %size
  ret i64 %sum
}

