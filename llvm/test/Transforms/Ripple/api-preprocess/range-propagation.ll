;; When an input carries both a range() attribute and !range metadata with
;; different bounds, the propagated range uses the intersection (tightest).
;; Here the attribute says [2, 20) and the metadata says [4, 8); intersection
;; is [4, 8).
define i64 @intersect_attribute_and_metadata(ptr %bs) {
; CHECK-LABEL: define i64 @intersect_attribute_and_metadata(
; CHECK-SAME: ptr [[BS:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[SRC:%.*]] = call range(i64 2, 20) i64 @range_4_8(), !range [[RNG1]]
; CHECK-NEXT:    [[BROADCAST:%.*]] = call range(i64 4, 8) i64 @llvm.ripple.broadcast.i64(ptr [[BS]], i64 1, i64 [[SRC]]), !range [[RNG1]]
; CHECK-NEXT:    ret i64 [[BROADCAST]]
;
entry:
  %src = call range(i64 2, 20) i64 @range_4_8(), !range !0
  %broadcast = call i64 @llvm.ripple.broadcast.i64(ptr %bs, i64 1, i64 %src)
  ret i64 %broadcast
}

