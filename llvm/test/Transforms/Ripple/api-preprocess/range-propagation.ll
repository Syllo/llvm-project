;; Shape operations that keep the scalar value domain of their inputs carry the
;; inputs' !range across, taking the union when there is more than one input.

;; broadcast, reshape and slice forward the !range of the value they carry.
define i64 @value_preserving_range_propagation() {
; CHECK-LABEL: define i64 @value_preserving_range_propagation() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[BS:%.*]] = call ptr @llvm.ripple.block.setshape.i64(i64 0, i64 5, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1)
; CHECK-NEXT:    [[ID:%.*]] = call range(i64 0, 5) i64 @llvm.ripple.block.index.i64(ptr [[BS]], i64 0), !range [[RNG0:![0-9]+]]
; CHECK-NEXT:    [[BROADCAST:%.*]] = call range(i64 0, 5) i64 @llvm.ripple.broadcast.i64(ptr [[BS]], i64 1, i64 [[ID]]), !range [[RNG0]]
; CHECK-NEXT:    [[RESHAPE:%.*]] = call range(i64 0, 5) i64 @llvm.ripple.reshape.i64(ptr [[BS]], i64 [[BROADCAST]]), !range [[RNG0]]
; CHECK-NEXT:    [[SLICE:%.*]] = call range(i64 0, 5) i64 @llvm.ripple.slice.i64(i64 [[RESHAPE]], i64 0, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1), !range [[RNG0]]
; CHECK-NEXT:    ret i64 [[SLICE]]
;
entry:
  %bs = call ptr @llvm.ripple.block.setshape.i64(i64 0, i64 5, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1)
  %id = call i64 @llvm.ripple.block.index.i64(ptr %bs, i64 0)
  %broadcast = call i64 @llvm.ripple.broadcast.i64(ptr %bs, i64 1, i64 %id)
  %reshape = call i64 @llvm.ripple.reshape.i64(ptr %bs, i64 %broadcast)
  %slice = call i64 @llvm.ripple.slice.i64(i64 %reshape, i64 0, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1, i64 -1)
  ret i64 %slice
}

