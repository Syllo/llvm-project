;; A two-input shuffle unions both ranges; a single-input one ignores the second
;; operand.
define i64 @shuffle_range_union() {
; CHECK-LABEL: define i64 @shuffle_range_union() {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LHS:%.*]] = call i64 @range_4_8(), !range [[RNG1]]
; CHECK-NEXT:    [[RHS:%.*]] = call i64 @range_10_13(), !range [[RNG2]]
; CHECK-NEXT:    [[SINGLE:%.*]] = call range(i64 4, 8) i64 @llvm.ripple.shuffle.i64(i64 [[LHS]], i64 [[RHS]], i1 false, ptr @shuffle_index), !range [[RNG1]]
; CHECK-NEXT:    [[PAIR:%.*]] = call range(i64 4, 13) i64 @llvm.ripple.shuffle.i64(i64 [[LHS]], i64 [[RHS]], i1 true, ptr @shuffle_index), !range [[RNG3]]
; CHECK-NEXT:    [[SUM:%.*]] = add i64 [[SINGLE]], [[PAIR]]
; CHECK-NEXT:    ret i64 [[SUM]]
;
entry:
  %lhs = call i64 @range_4_8(), !range !0
  %rhs = call i64 @range_10_13(), !range !1
  %single = call i64 @llvm.ripple.shuffle.i64(i64 %lhs, i64 %rhs, i1 false, ptr @shuffle_index)
  %pair = call i64 @llvm.ripple.shuffle.i64(i64 %lhs, i64 %rhs, i1 true, ptr @shuffle_index)
  %sum = add i64 %single, %pair
  ret i64 %sum
}

