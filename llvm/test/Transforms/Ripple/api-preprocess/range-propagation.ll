;; stack takes the union of the ranges of all stacked values.
define i64 @stack_range_union(ptr %bs) {
; CHECK-LABEL: define i64 @stack_range_union(
; CHECK-SAME: ptr [[BS:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[LHS:%.*]] = call i64 @range_4_8(), !range [[RNG1:![0-9]+]]
; CHECK-NEXT:    [[RHS:%.*]] = call i64 @range_10_13(), !range [[RNG2:![0-9]+]]
; CHECK-NEXT:    [[STACK:%.*]] = call range(i64 4, 13) i64 (ptr, i64, ...) @llvm.ripple.stack.i64(ptr [[BS]], i64 [[LHS]], i64 [[RHS]]), !range [[RNG3:![0-9]+]]
; CHECK-NEXT:    ret i64 [[STACK]]
;
entry:
  %lhs = call i64 @range_4_8(), !range !0
  %rhs = call i64 @range_10_13(), !range !1
  %stack = call i64 (ptr, i64, ...) @llvm.ripple.stack.i64(ptr %bs, i64 %lhs, i64 %rhs)
  ret i64 %stack
}

