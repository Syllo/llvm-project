target triple = "aarch64-unknown-linux-gnu"

; Adapted from @singleBlock in get_active_lane_mask.ll: the ripple block shape
; here is 3, which is not naturally a legal vector length on the target.

define void @singleBlock(ptr %Arr, i64 %N, i64 %i) #0 {
; CHECK-LABEL: define void @singleBlock(
; CHECK-SAME: ptr [[ARR:%.*]], i64 [[N:%.*]], i64 [[I:%.*]]) #[[ATTR0:[0-9]+]] {
; CHECK-NEXT:  [[ENTRY:.*:]]
; CHECK-NEXT:    [[NOOVERFLOWCOND:%.*]] = icmp ult i64 [[I]], 5000
; CHECK-NEXT:    call void @llvm.assume(i1 [[NOOVERFLOWCOND]])
; CHECK-NEXT:    [[CMP_RIPPLE_LS_INSTANCE_PAD:%.*]] = call <4 x i1> @llvm.get.active.lane.mask.v4i1.i64(i64 [[I]], i64 [[N]])
; CHECK-NEXT:    [[ARRAYIDX_RIPPLE_BRANCH_CLONE:%.*]] = getelementptr inbounds nuw [4 x i8], ptr [[ARR]], i64 [[I]]
; CHECK-NEXT:    [[CMP_RIPPLE_LS_INSTANCE_PAD_PAD:%.*]] = and <4 x i1> [[CMP_RIPPLE_LS_INSTANCE_PAD]], <i1 true, i1 true, i1 true, i1 false>
; CHECK-NEXT:    call void @llvm.masked.store.v4f32.p0(<4 x float> splat (float 5.000000e+00), ptr align 4 [[ARRAYIDX_RIPPLE_BRANCH_CLONE]], <4 x i1> [[CMP_RIPPLE_LS_INSTANCE_PAD_PAD]])
; CHECK-NEXT:    ret void
;
entry:
  %noOverflowCond = icmp ult i64 %i, 5000
  call void @llvm.assume(i1 %noOverflowCond)
  %0 = tail call ptr @llvm.ripple.block.setshape.i64(i64 0, i64 3, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1, i64 1)
  %1 = tail call i64 @llvm.ripple.block.index.i64(ptr %0, i64 0)
  %add = add i64 %1, %i
  %cmp = icmp ult i64 %add, %N
  br i1 %cmp, label %if.then, label %if.end

if.then:
  %arrayidx = getelementptr inbounds nuw [4 x i8], ptr %Arr, i64 %add
  store float 5.000000e+00, ptr %arrayidx, align 4
  br label %if.end

if.end:
  ret void
}

attributes #0 = { "target-features"="+neon,+sve" }
